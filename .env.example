# lab77-webhook-tracking — variáveis de ambiente
# Copie pra .env e preencha. NUNCA commitar o .env (está no .gitignore e no
# .dockerignore). Na VPS: chmod 600 .env

# ── Bling (OAuth2) ─────────────────────────────────────────────────────────
# App em developer.bling.com.br. O redirect URI cadastrado lá PRECISA ser
# <BASE_URL>/oauth/callback. Obrigatórias — o serviço não sobe sem elas.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Secret do webhook de NF-e (HMAC-SHA256 do body). Configurado junto com o
# webhook no painel do Bling. SEM ela o webhook aceita qualquer request
# (o boot grita ERRO, mas sobe).
BLING_WEBHOOK_SECRET=

# Opcional — bootstrap de token sem OAuth manual. ATENÇÃO: o refresh token do
# Bling ROTACIONA a cada uso; este valor fica stale após o primeiro refresh.
# O caminho normal é autorizar via <BASE_URL>/authorize (tokens persistem em
# /data/.bling-tokens.json).
#BLING_REFRESH_TOKEN=

# ── Frete Barato ───────────────────────────────────────────────────────────
FRETEBARATO_TOKEN=
FRETEBARATO_CUSTOMER_ID=
# Plataforma usada nas URLs da API (default: shopify)
#FRETEBARATO_PLATAFORMA=shopify

# CNPJ da empresa (só dígitos) — usado nas consultas ao Frete Barato
EMPRESA_CNPJ=

# ── Servidor ───────────────────────────────────────────────────────────────
# API key dos endpoints administrativos (/reprocessar, /fila, /etiquetas,
# /api/*). SEM ela esses endpoints ficam abertos (o boot grita ERRO).
WEBHOOK_API_KEY=

# URL pública do serviço — usada no redirect do OAuth e nos links de etiqueta
# retornados pela API. Na VPS: https://tracking.fabrica77.com.br
BASE_URL=

# Porta interna (o Dockerfile já define 8080; só sobrescreva se souber por quê)
#PORT=8080

# Diretório (NÃO arquivo) onde .bling-tokens.json é persistido.
# O Dockerfile já define /data — não sobrescrever no Docker.
#TOKEN_STORAGE_PATH=/data

# ── Comportamento ──────────────────────────────────────────────────────────
# Gravação do código de rastreio de volta no Bling (PUT pedido / POST
# /logisticas/objetos). DESLIGADA por padrão — nada no fluxo atual consome
# (jun/2026). Ligar exige escopo Logística no app Bling. Valores: 1|true|sim
#GRAVAR_RASTREIO_BLING=

# ── Migração (SÓ no Railway, temporária) ───────────────────────────────────
# Habilita GET /export-tokens?key=... — NUNCA colocar no .env da VPS.
# Remover do Railway depois do cutover.
#EXPORT_TOKENS_KEY=
